{
  "root": true,
  "env": {
    "browser": true,
    "webextensions": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "extends": ["eslint:recommended", "prettier"],
  "ignorePatterns": [
    "src/ui/cm/**",
    "tools/bench/baseline/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": ["src/scripts/inject/*.js", "src/scripts/inject.js"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off",
        "prefer-const": "off",
        "no-redeclare": "off",
        "no-shadow": "off"
      }
    },
    {
      "files": ["src/scripts/consts.js"],
      "rules": {
        "no-redeclare": "off",
        "no-shadow": "off"
      }
    }
  ],
  "rules": {
    "strict": "off",
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "no-console": "off",
    "no-underscore-dangle": "off",
    "func-names": "off",
    "no-use-before-define": "off",
    "no-param-reassign": "off",
    "no-shadow": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "object-shorthand": "error",
    "prefer-template": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "globals": {
    "CodeMirror": "readonly",
    "BLOCKTUBE_CONSTS": "readonly",
    "CONTEXT_BLOCK_TYPES": "readonly",
    "globalThis": "readonly",
    "importScripts": "readonly"
  }
}